<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <com.mapbox.maps.MapView
        android:id="@+id/hotspotsMapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:forceDarkAllowed="false" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnBackHotspotsMap"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_margin="16dp"
        app:icon="@drawable/ic_back"
        app:iconTint="@color/text_primary"
        android:background="@drawable/bottom_panel_rounded"
        android:backgroundTint="@color/white"
        app:iconPadding="0dp"
        android:padding="0dp"/>

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/toggleTimeRange"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        app:singleSelection="true"
        app:checkedButton="@+id/btnWeekly">
        <Button
            android:id="@+id/btnWeekly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Weekly" />
        <Button
            android:id="@+id/btnMonthly"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/summaryCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/tvHotspotTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sales Hotspots"
                android:textStyle="bold"
                android:textSize="18sp"
                android:textColor="@color/primary"/>
            <TextView
                android:id="@+id/tvHotspotDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Yellow to red shows increasing sales activity. Select a hot zone for details."
                android:textSize="12sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</RelativeLayout>
